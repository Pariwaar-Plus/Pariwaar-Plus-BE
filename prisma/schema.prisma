// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Relationship {
  SON
  DAUGHTER
  RELATIVE
  LEGAL_GUARDIAN
}



model User {
  id            String @id @default(uuid())
  name          String
  email         String @unique
  password      String
  role          Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  refreshTokens RefreshToken[]
  passwordResetToken PasswordResetToken[]

  // Role-specific relations
  careAgent CareAgent?
  client    Client?

  deletedAt DateTime?
  @@map("users")

}

enum Role {
  ADMIN
  CARE_AGENT
  CLIENT
}

enum CareAgentStatus {
  AVAILABLE
  ASSIGNED
  ON_LEAVE
  INACTIVE
}

enum BillingType {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model CareAgent {
  id            String @id @default(uuid())
  userId        String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- Professional Info ---
  employeeId      String      @unique // e.g., SAH-2024-001
  status          CareAgentStatus @default(AVAILABLE)
  qualification   String      
  specialization  String?     // e.g., Elder Care, Post-Op, Child Care
  experience      Int         // In years
  joinedDate      DateTime    @default(now())

  // --- Personal & Contact ---
  phone           String      @unique
  secondaryPhone  String?
  gender          Gender
  dateOfBirth     DateTime

  // --- Address Details ---
  city            String
  district        String?     // Useful for regional filtering
  ward            String
  tole            String
  latitude        Float?      // For "Agents near me" features
  longitude       Float?

  // --- Documents & Compliance ---
  citizenshipNo   String?     @unique
  licenseNo       String?     // Medical/Driving license

  // --- Relations ---
  assignments   CareAssignment[]
  visitLogs     VisitLog[]

  deletedAt DateTime?
  @@map("careagents")
}

model Client {
  id      String @id @default(uuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Contact ──
  phone          String  @unique
  countryCode    String  // e.g. "+1", "+61", "+44" 
  secondaryPhone String?

  // ── Location (abroad) ──
  country  String
  timezone String
  address  String?
  city     String?

  // ── Billing ──
  billingType   BillingType   @default(MONTHLY)
  paymentStatus PaymentStatus @default(PENDING)

  // ── Relations ──
  careReceivers CareReceiver[]

  // ── Meta ──
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  @@map("clients")
}


model CareReceiver {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // ── Personal ──
  name        String
  dateOfBirth DateTime
  gender      Gender        // reuse existing enum

  // ── Contact & Location (in Nepal) ──
  phone    String?
  city     String
  district String?
  ward     String
  tole     String

  // ── Medical Info ──
  bloodGroup       String?
  medicalCondition String?  // brief description e.g. "Diabetes, Hypertension"
  allergies        String?
  mobilityStatus   MobilityStatus @default(INDEPENDENT)
  notes            String?        // any extra admin notes

  // ── Emergency Contact ──
  emergencyContactName  String?
  emergencyContactPhone String?

  // ── Relations ──
  assignments CareAssignment[]

  // ── Meta ──
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  @@map("carereceivers")
}

enum MobilityStatus {
  INDEPENDENT      // walks on their own
  ASSISTED         // needs help walking
  WHEELCHAIR       // wheelchair bound
  BEDRIDDEN        // fully bedridden
}


model CareAssignment {
  id             String   @id @default(uuid())
  careAgentId    String
  careAgent      CareAgent    @relation(fields: [careAgentId], references: [id])
  careReceiverId String
  careReceiver   CareReceiver @relation(fields: [careReceiverId], references: [id])

  status     AssignmentStatus @default(ACTIVE)
  notes      String?

  // ── Relations ──
  visitLogs VisitLog[]
  assignmentSchedules CareAssignmentSchedule[]

  // ── Meta ──
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  @@unique([careAgentId, careReceiverId])
  @@map("careassignment")
}

model CareAssignmentSchedule {
  id             String   @id @default(uuid())
  assignmentId String
  assignment   CareAssignment @relation(fields: [assignmentId], references: [id])
  startDate DateTime
  endDate DateTime?
  frequency AssignmentFrequency
  
  // ── Meta ──
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  @@map("careassignmentschedule")
}

enum AssignmentFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  ON_DEMAND
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  ON_HOLD
  INACTIVE
}

model VisitLog {
  id           String         @id @default(uuid())
  assignmentId String
  assignment   CareAssignment @relation(fields: [assignmentId], references: [id])
  careAgentId  String
  careAgent    CareAgent      @relation(fields: [careAgentId], references: [id])

  // ── Visit Timing ──
  scheduledAt  DateTime
  checkInAt    DateTime?
  checkOutAt   DateTime?

  // ── Status ──
  status             VisitStatus @default(SCHEDULED)
  cancellationReason String?

  // ── Vitals (structured) ──
  bloodPressureSystolic  Int?     // mmHg e.g. 120
  bloodPressureDiastolic Int?     // mmHg e.g. 80
  pulseRate              Int?     // bpm
  temperature            Float?   // °C
  oxygenSaturation       Float?   // SpO2 %
  weight                 Float?   // kg
  bloodSugar             Float?   // mg/dL (important for diabetics)
  respiratoryRate        Int?     // breaths per minute

  // ── Pain & Wellbeing ──
  painLevel    Int?    // 0–10 scale
  mood         Mood?

  // ── Medications ──
  medicationsGiven  String?  // e.g. "Metformin 500mg, Amlodipine 5mg"
  medicationsSkipped String? // and reason

  // ── Clinical Observations ──
  symptoms        String?  // free text e.g. "mild cough, fatigue"
  woundCare       String?  // description of any wound care performed
  woundCondition  WoundCondition?

  // ── Mobility ──
  mobilityAssessment  MobilityStatus?  // reuse existing enum
  mobilityNotes       String?

  // ── Notes ──
  agentNotes  String?   // general visit notes by agent
  adminNotes  String?   // added by admin

  // ── Meta ──
  createdBy  String    // userId
  updatedBy  String?   // userId
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  @@map("visitlogs")
}

enum VisitStatus {
  SCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

enum Mood {
  HAPPY
  CALM
  ANXIOUS
  CONFUSED
  AGITATED
  DEPRESSED
}

enum WoundCondition {
  HEALING
  STABLE
  WORSENING
  INFECTED
  NOT_APPLICABLE
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

