// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  url      = env("DATABASE_URL")
}
datasource db {
  provider = "postgresql"
}

model User {
  id            String @id @default(uuid())
  name          String
  email         String @unique
  password      String
  role          Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  refreshTokens RefreshToken[]

  // 🔗 Role-specific relations
  careAgent CareAgent?
  client    Client?

}

enum Role {
  ADMIN
  CARE_AGENT
  CLIENT
}

model CareAgent {
  id            String @id @default(uuid())
  userId        String @unique

  qualification String  
  experience    Int
  contact       String
  city          String?
  ward          String?
  tole          String?

  user User @relation(fields: [userId], references: [id])
  assignments   CareAssignment[]
  visitLogs     VisitLog[]
}

model Client {
  id        String @id @default(uuid())
  userId    String @unique

  country   String?
  city      String?
  address   String?
  contact   String?

  user User @relation(fields: [userId], references: [id])
  careReceivers CareReceiver[]
}

model CareReceiver {
  id                String   @id @default(uuid())
  clientId          String
  
  // Parent details
  name              String
  age               Int
  gender            String
  contactNumber     String
  
  // Address
  city              String
  ward              String?
  tole              String?

  // Medical info
  medicalHistory    String?  @db.Text
  existingConditions String[]

  client            Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignments       CareAssignment[]
  visitLogs         VisitLog[]       

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model CareAssignment {
  id             String       @id @default(uuid())
  careReceiverId String
  careAgentId    String
  
  careReceiver   CareReceiver @relation(fields: [careReceiverId], references: [id])
  careAgent      CareAgent    @relation(fields: [careAgentId], references: [id])

  createdAt      DateTime     @default(now())

  @@unique([careReceiverId, careAgentId]) // Admin assigns care agents 
}

model VisitLog {
  id                String   @id @default(uuid())
  careReceiverId    String
  careAgentId       String
  
  // Health Monitoring Module
  visitDate         DateTime @default(now())
  
  // Vital Signs
  systolicBP        Int      
  diastolicBP       Int
  bloodSugar        Float?   
  oxygenLevel       Int?     
  weight            Float?   
  
  // Qualitative Data
  generalNotes      String?  @db.Text 
  medicationAdherence Boolean 
  medicationNotes   String?  
  
  careReceiver      CareReceiver @relation(fields: [careReceiverId], references: [id])
  careAgent         CareAgent    @relation(fields: [careAgentId], references: [id])

  createdAt         DateTime     @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

